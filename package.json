{
  "name": "trainersapp",
  "private": true,
  "version": "0.29.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulator": "node tools/firebase.mjs emulators:start --project demo-toptraining --only auth,firestore",
    "regels:live": "node tools/firebase.mjs deploy --project live --only firestore:rules",
    "test:online": "node tools/firebase.mjs emulators:exec --project demo-toptraining --only auth,firestore \"vitest run --config vitest.online.config.ts\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "firebase": "^11.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^13.35.1",
    "jiti": "^2.7.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
